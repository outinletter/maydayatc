    "Independent learning aid. No affiliation with or endorsement by ICAO, FAA, Apple, airlines, or ATC authorities.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unabhängige Lernhilfe. Keine Verbindung zu oder Anerkennung durch ICAO, FAA, Apple, Fluggesellschaften oder ATC-Behörden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Herramienta de aprendizaje independiente. Sin afiliación ni aprobación de la OACI, FAA, Apple, aerolíneas o autoridades ATC."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outil pédagogique indépendant. Aucune affiliation ni approbation de l’OACI, de la FAA, d’Apple, des compagnies ou des autorités ATC."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausilio didattico indipendente. Nessuna affiliazione o approvazione da ICAO, FAA, Apple, compagnie aeree o autorità ATC."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "独立した学習補助ツールです。ICAO、FAA、Apple、航空会社、管制機関との提携や承認はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "독립적인 학습 보조 도구입니다. ICAO, FAA, Apple, 항공사 또는 관제기관과 제휴하거나 이들의 인증을 받지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onafhankelijk leerhulpmiddel. Niet verbonden aan of goedgekeurd door ICAO, FAA, Apple, luchtvaartmaatschappijen of ATC-instanties."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramenta de estudo independente. Sem vínculo ou endosso da ICAO, FAA, Apple, companhias aéreas ou autoridades ATC."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Независимое учебное пособие. Нет связи с ICAO, FAA, Apple, авиакомпаниями и органами УВД или их одобрения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "独立学习辅助工具。与ICAO、FAA、Apple、航空公司或空管机构无隶属关系，也未获其认可。"
          }
        }
      }
    },
