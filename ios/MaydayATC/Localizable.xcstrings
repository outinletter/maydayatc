    "Created by a pilot for pilots and air traffic controllers to practice aviation English outside operational duties.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von einem Piloten entwickelt, damit Piloten und Fluglotsen außerhalb des Dienstes Luftfahrtenglisch üben können."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada por un piloto para que pilotos y controladores practiquen inglés aeronáutico fuera de sus funciones operativas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créée par un pilote pour permettre aux pilotes et contrôleurs de pratiquer l’anglais aéronautique hors service."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
