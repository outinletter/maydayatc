    "An older content revision was ignored. Your lessons are unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine ältere Inhaltsversion wurde ignoriert. Deine Lektionen bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha ignorado una versión anterior. Tus lecciones no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ancienne version a été ignorée. Vos leçons restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versione precedente è stata ignorata. Le lezioni non cambiano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "古い版のコンテンツを無視しました。レッスンは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 버전의 콘텐츠를 건너뛰었습니다. 기존 수업은 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een oudere inhoudsversie is genegeerd. Je lessen zijn ongewijzigd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão anterior foi ignorada. Suas lições não foram alteradas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старая версия материалов пропущена. Уроки не изменены."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已忽略较旧的内容版本。课程保持不变。"
          }
        }
      }
    },
