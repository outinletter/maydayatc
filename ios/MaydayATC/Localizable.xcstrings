    "Read the dialogue and choose the next response. Compare both examples and their explanations.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies den Dialog und wähle die nächste Antwort. Vergleiche beide Beispiele und ihre Erklärungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee el diálogo y elige la siguiente respuesta. Compara ambos ejemplos y sus explicaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez le dialogue et choisissez la réponse suivante. Comparez les deux exemples et leurs explications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi il dialogo e scegli la risposta successiva. Confronta entrambi gli esempi e le spiegazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を読んで次の応答を選び、両方の例と解説を比較してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대화를 읽고 다음 응답을 선택하세요. 두 예문과 각각의 설명을 비교할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees de dialoog en kies de volgende reactie. Vergelijk beide voorbeelden en hun uitleg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o diálogo e escolha a próxima resposta. Compare os dois exemplos e suas explicações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Прочитайте диалог и выберите следующую реплику. Сравните оба примера и объяснения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "阅读对话并选择下一句应答。比较两个示例及其解释。"
          }
        }
      }
    },
    "Read the dialogue first. This checks reading comprehension, not operational decisions.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lies zuerst den Dialog. Geprüft wird das Leseverständnis, keine betrieblichen Entscheidungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee primero el diálogo. Se evalúa la comprensión lectora, no las decisiones operativas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez d’abord le dialogue. L’exercice vérifie la compréhension écrite, pas les décisions opérationnelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi prima il dialogo. Si verifica la comprensione, non le decisioni operative."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず会話を読んでください。運航判断ではなく読解力を確認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 대화를 읽으세요. 실제 운항 판단이 아니라 독해 이해도를 확인하는 문제입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lees eerst de dialoog. Dit toetst tekstbegrip, geen operationele beslissingen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia o diálogo primeiro. O exercício verifica a compreensão de leitura, não decisões operacionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала прочитайте диалог. Проверяется понимание текста, а не эксплуатационные решения."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先阅读对话。此练习检验阅读理解，不涉及运行决策。"
          }
        }
      }
    },
