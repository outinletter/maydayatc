    "Say a response in your own words, then reveal the example. No audio is recorded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworte mit eigenen Worten und zeige dann das Beispiel. Es wird kein Ton aufgenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde con tus propias palabras y después muestra el ejemplo. No se graba audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répondez avec vos propres mots, puis affichez l’exemple. Aucun son n’est enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi con parole tue, poi mostra l’esempio. Nessun audio viene registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の言葉で応答してから例を表示してください。音声は録音されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자신의 말로 응답한 뒤 예문을 확인하세요. 음성은 녹음하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoord in je eigen woorden en toon daarna het voorbeeld. Er wordt geen audio opgenomen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Responda com suas palavras e depois mostre o exemplo. Nenhum áudio é gravado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответьте своими словами, затем откройте пример. Звук не записывается."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用自己的话应答，再显示示例。不会录音。"
          }
        }
      }
    },
