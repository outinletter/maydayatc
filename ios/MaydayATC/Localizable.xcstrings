    "Only your first answer counts. You may compare both explanations. Start a new round to answer again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die erste Antwort zählt. Du kannst beide Erklärungen vergleichen. Starte zum erneuten Antworten eine neue Runde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo cuenta tu primera respuesta. Puedes comparar ambas explicaciones. Inicia una nueva ronda para volver a responder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule la première réponse compte. Vous pouvez comparer les deux explications. Commencez une nouvelle série pour répondre à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conta solo la prima risposta. Puoi confrontare entrambe le spiegazioni. Inizia un nuovo turno per rispondere di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録されるのは最初の回答のみです。両方の解説を比較できます。再回答には新しいラウンドを始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 응답만 기록됩니다. 두 설명을 모두 비교할 수 있습니다. 다시 답하려면 새 회차를 시작하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen je eerste antwoord telt. Je kunt beide uitlegteksten vergelijken. Start een nieuwe ronde om opnieuw te antwoorden."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas a primeira resposta conta. Você pode comparar as duas explicações. Inicie outra rodada para responder novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Учитывается только первый ответ. Можно сравнить оба объяснения. Для повторного ответа начните новый раунд."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅记录首次作答。可以比较两种解释。重新作答请开始新一轮。"
          }
        }
      }
    },
