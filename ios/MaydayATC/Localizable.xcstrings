          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há erros para revisar nesta função. Escolha uma lição para praticar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой роли нет ошибок для повторения. Выберите урок и начните практику."
          }
        },
