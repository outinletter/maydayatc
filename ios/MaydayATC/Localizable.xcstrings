    "No mistakes to review for this role. Choose a lesson to start practicing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Fehler für diese Rolle zu wiederholen. Wähle eine Lektion zum Üben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay errores para repasar en este rol. Elige una lección para practicar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune erreur à revoir pour ce rôle. Choisissez une leçon pour commencer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun errore da ripassare per questo ruolo. Scegli una lezione per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この役割には復習する間違いがありません。レッスンを選んで練習を始めてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 역할에 복습할 오답이 없습니다. 수업을 선택해 연습하세요."
          }
        },
        "nl": {
